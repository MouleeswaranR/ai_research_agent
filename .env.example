# ============================================================
# Auto Dev Company – Environment Variables (Example)
# ============================================================

# ── LLM Provider (primary) ─────────────────────────────────
# Options: "nvidia_nim" | "gemini" | "openrouter" | "groq"
LLM_PROVIDER=nvidia_nim
FALLBACK_PROVIDERS=groq,gemini,openrouter

# ── Groq LLM (fallback) ──────────────────────────────────
# Get API key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── NVIDIA NIM ─────────────────────────────────────────────
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k2.6
NVIDIA_NIM_FAST_MODEL=minimaxai/minimax-m3

# ── Neon DB (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Sandbox ───────────────────────────────────────────────
SANDBOX_TIMEOUT=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_DISABLED=true

# ── Review Gate ───────────────────────────────────────────
REVIEW_MAX_RETRIES=3
COVERAGE_THRESHOLD=85
COMPLEXITY_THRESHOLD=10
SECURITY_SEVERITY_BLOCK=high

# ── Tracing ───────────────────────────────────────────────
TRACE_ENABLED=true
TRACE_SAVE_TO_DISK=true

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Graph Pipeline ────────────────────────────────────────
ENABLE_GRAPH_PIPELINE=false

# ── Per-Agent Model Routing (NVIDIA NIM) ──────────────────────
# Planning agents → Nemotron-3-Ultra (frontier reasoning)
NIM_MODEL_PRODUCT_STRATEGIST=nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_PROJECT_MANAGER=nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_SYSTEM_ARCHITECT=nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_SECURITY_ARCHITECT=nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_PLANNER=nvidia/nemotron-3-ultra-550b-a55b
# Coding agents → Kimi-K2.6 (advanced multimodal coding, agentic)
NIM_MODEL_CODE_GENERATOR=moonshotai/kimi-k2.6
NIM_MODEL_CODE_GENERATOR_ESCALATION=nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_TEST_WRITER=moonshotai/kimi-k2.6
NIM_MODEL_REFACTOR=moonshotai/kimi-k2.6
# Review agents → MiniMax-M3 (fast, multimodal)
NIM_MODEL_CRITIQUE=minimaxai/minimax-m3
NIM_MODEL_CRITIQUE_ESCALATION=nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_SELF_EVAL=minimaxai/minimax-m3
# Post-processing → MiniMax-M3
NIM_MODEL_DEPLOYMENT=minimaxai/minimax-m3
NIM_MODEL_MONITORING=minimaxai/minimax-m3
NIM_MODEL_QUALITY_EVALUATOR=minimaxai/minimax-m3
